prefix=@PREFIX@
exec_prefix=${prefix}
libdir=@LIBDIR@
includedir=@INCLUDEDIR@

Name: textforge-c
Description: C bindings for the TextForge text-processing DSL
Version: @VERSION@
URL: https://github.com/redlintles/textforge
Libs: -L${libdir} -ltextforge_c
Libs.private: @PRIVATE_LIBS@
Cflags: -I${includedir}
